From f5ebe2b354af155406e2ebd664507db80420c71c Mon Sep 17 00:00:00 2001
From: Brocco <contact@broccoli.boo>
Date: Thu, 17 Sep 2026 11:07:14 -0700
Subject: [PATCH] Track reveal_idle_id to prevent stale reference

---
 src/notification/notification.vala | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/src/notification/notification.vala b/src/notification/notification.vala
index 637762a3..099f52fe 100644
--- a/src/notification/notification.vala
+++ b/src/notification/notification.vala
@@ -65,6 +65,7 @@ namespace SwayNotificationCenter {
         }
 
         private uint timeout_id = 0;
+        private uint reveal_idle_id = 0;
 
         public bool is_timed { get; construct; default = false; }
 
@@ -298,7 +299,11 @@ namespace SwayNotificationCenter {
             set_actions ();
             set_style_urgency ();
 
-            Idle.add_once (() => {
+            if (reveal_idle_id > 0) {
+                Source.remove (reveal_idle_id);
+            }
+            reveal_idle_id = Idle.add_once (() => {
+                reveal_idle_id = 0;
                 revealer.set_reveal_child (true);
             });
 
@@ -682,6 +687,16 @@ namespace SwayNotificationCenter {
             }
         }
 
+        public override void dispose () {
+            if (reveal_idle_id > 0) {
+                Source.remove (reveal_idle_id);
+                reveal_idle_id = 0;
+            }
+            remove_noti_timeout ();
+
+            base.dispose ();
+        }
+
         public void replace_notification (NotifyParams new_params) {
             this.param = new_params;
             build_noti ();
